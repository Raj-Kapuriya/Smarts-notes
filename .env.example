# ============================================================
# Smart Notes - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ============================================================

# Supabase Configuration (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (https://aistudio.google.com)
GOOGLE_API_KEY=your-google-gemini-api-key

# Hugging Face API Token (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-api-token

# Cloudinary Configuration (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Pinecone Vector Database (https://pinecone.io)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=smart-notes-index

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_SECRET_KEY=your-flask-secret-key-change-this
